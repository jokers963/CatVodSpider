{
  "spider": "https://jokers963.github.io/CatVodSpider/jar/gm.jar",
  "sites": [
    {
      "key": "supjav",
      "name": "SupJav",
      "type": 3,
      "api": "csp_GM",
      "searchable": 1,
      "quickSearch": 1,
      "changeable": 0,
      "filterable": 1,
      "timeout": 60,
      "ext": {
        "userScript": "https://jokers963.github.io/CatVodSpider/js/supjav.user.js?v=5",
        "debug": false,
        "webViewSettings": {
          "blockNetworkImage": true,
          "blockList": [
            "*.css*",
            "*.ico*",
            "https://*.adforcast.com/*",
            "https://*.adxadserv.com/*",
            "https://*.bbrdbr.com/*",
            "https://*.fanza.cc/*",
            "https://*.googletagmanager.com/*",
            "https://*.google-analytics.com/*",
            "https://*.mnaspm.com/*",
            "https://*.recombee.com/*",
            "https://*.sacdnssedge.com/*",
            "https://*.tapioni.com/*",
            "https://*.yandex.ru/*",
            "https://*/prebid.min.js",
            "https://divisiondrearilyunfiled.com/*",
            "https://endowmentoverhangutmost.com/*",
            "https://imasdk.googleapis.com/*",
            "https://psoroumukr.com/*",
            "https://static.ads-twitter.com/*",
            "https://streamhg.com/*",
            "https://*.tsyndicate.com/*"
          ]
        },
        "playUrlMatch": [
          "https://*.cdn-centaurus.com/*/master.m3u8*",
          "https://*.cloudatacdn.com/*",
          "https://*.cloudflarestorage.com/*",
          "https://*.linkofnyz.com/*.m3u8*",
          "https://*.tapecontent.net/*",
          "https://*.turboviplay.*/*.m3u8*",
          "https://*.voe-network.net/*/master.m3u8*",
          "https://dood.la/pass_md5/*",
          "https://streamtape.com/get_video*"
        ],
        "spider": {
          "homeContent": {"loadUrl": "https://supjav.com/zh/popular"},
          "categoryContent": {"loadUrl": "https://supjav.com/zh/${tid}/page/${pg:-1}?sort=${sort:-quantity}"},
          "detailContent": {"loadUrl": "https://supjav.com/zh/${id}"},
          "playerContent": {"loadUrl": "https://supjav.com/zh/${pathname}#${link}"},
          "searchContent": {"loadUrl": "https://supjav.com/zh/page/${pg:-1}?s=${key}"}
        }
      }
    },
    {
      "key": "missav",
      "name": "MissAV",
      "type": 3,
      "api": "csp_GM",
      "searchable": 1,
      "quickSearch": 1,
      "changeable": 0,
      "filterable": 0,
      "timeout": 60,
      "ext": {
        "userScript": "https://jokers963.github.io/CatVodSpider/js/missav.user.js?v=3",
        "debug": false,
        "webViewSettings": {
          "blockNetworkImage": true
        },
        "spider": {
          "homeContent": {"loadUrl": "https://missav.ws/cn/new"},
          "categoryContent": {"loadUrl": "https://missav.ws/cn/${tid}?page=${pg:-1}"},
          "detailContent": {"loadUrl": "https://missav.ws/cn/${id}"},
          "searchContent": {"loadUrl": "https://missav.ws/cn/search/${key}?page=${pg:-1}"}
        }
      }
    },
    {
      "key": "jable",
      "name": "Jable",
      "type": 3,
      "api": "csp_GM",
      "searchable": 1,
      "quickSearch": 1,
      "changeable": 0,
      "filterable": 0,
      "timeout": 60,
      "ext": {
        "userScript": "https://jokers963.github.io/CatVodSpider/js/jable.user.js?v=2",
        "debug": false,
        "webViewSettings": {
          "blockNetworkImage": false
        },
        "spider": {
          "homeContent": {"loadUrl": "https://jable.tv/"},
          "categoryContent": {"loadUrl": "https://jable.tv/categories/${tid}/?mode=async&function=get_block&block_id=list_videos_common_videos_list&sort_by=post_date&from=${pg:-01}"},
          "detailContent": {"loadUrl": "https://jable.tv/videos/${id}/"},
          "playerContent": {"loadUrl": "https://jable.tv/videos/${pathname}/"},
          "searchContent": {"loadUrl": "https://jable.tv/search/${key}/"}
        }
      }
    }
  ],
  "parses": [],
  "lives": [],
  "rules": [],
  "ads": []
}
